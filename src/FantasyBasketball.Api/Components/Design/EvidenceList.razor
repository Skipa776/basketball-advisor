<ul class="evidence-list" data-compact="@Compact">
    @foreach (var item in Items)
    {
        var presentation = Present(item.Polarity);
        <li data-polarity="@item.Polarity.ToString().ToLowerInvariant()">
            <span class="icon" aria-hidden="true">@presentation.Icon</span>
            <span class="polarity">@presentation.Label</span>
            <span class="statement">@item.Statement</span>
            @if (item.Magnitude is { } magnitude)
            {
                <span class="magnitude" data-numeric>
                    @magnitude.ToString("+0.##;-0.##;0", CultureInfo.InvariantCulture)
                </span>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RecommendationEvidence> Items { get; set; } = [];

    [Parameter]
    public bool Compact { get; set; }

    private static (string Icon, string Label) Present(
        EvidencePolarity polarity) =>
        polarity switch
        {
            EvidencePolarity.Supporting => ("+", "Support"),
            EvidencePolarity.Risk => ("−", "Risk"),
            _ => ("·", "Context"),
        };
}
