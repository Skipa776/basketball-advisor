@* A plain form post, not an interactive component. The switcher has to work on
   the server-rendered pass, before any circuit exists, and it changes a cookie
   -- which a Blazor event handler cannot do after the response has started.

   It also keeps this presentational: the component receives options and renders
   them, and knows nothing about where they came from. *@
@if (Options.Count > 0)
{
    <form class="league-switch" method="post" action="/account/active-league/submit">
        <AntiforgeryToken />
        <label for="active-league">League</label>
        <select id="active-league" name="leagueId">
            @foreach (var option in Options)
            {
                <option value="@option.Id" selected="@(option.Id == SelectedId)">
                    @option.Name
                </option>
            }
        </select>
        @* Submitting on change needs script. Without it the button is the only
           way to commit, so it is always rendered rather than revealed. *@
        <button type="submit">Switch</button>
    </form>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<LeagueOption> Options { get; set; } = [];

    [Parameter]
    public Guid? SelectedId { get; set; }
}
