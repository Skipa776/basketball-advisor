@* The Riot pattern: full-bleed art, wordmark in the corner, one centred card
   carrying the whole form. *@
<div class="auth-stage">
    <CourtBackdrop />
    <a class="stage-wordmark" href="/">
        <span class="mark" aria-hidden="true">FB</span>
        <span>Fastbreak</span>
    </a>
    <div class="auth-card">
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="description">@Description</p>
        }
        @ChildContent
        @* The divider is tied to ShowFederated, not to the fragment being
           non-null: a supplied-but-empty fragment would otherwise print "or"
           above nothing. *@
        @if (ShowFederated && Federated is not null)
        {
            <div class="federated">
                <p class="divider"><span>or</span></p>
                @Federated
            </div>
        }
        @if (Secondary is not null)
        {
            <div class="secondary">@Secondary</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    [Parameter]
    public RenderFragment? Federated { get; set; }

    [Parameter]
    public bool ShowFederated { get; set; }

    [Parameter]
    public RenderFragment? Secondary { get; set; }
}
