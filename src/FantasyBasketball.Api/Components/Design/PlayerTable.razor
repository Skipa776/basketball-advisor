@* Ranked is the draft board: the row order IS the ranking, so the rank number
   and the projection columns mean something. Unranked is a search result, where
   the order is alphabetical and "Rank 1" would be a claim about a player that
   happens to start with A. The columns are dropped rather than dashed, because
   a column of em dashes says the number is missing when the truth is that the
   number does not apply to this view.

   There is no ADP column. DraftValue does not carry the average draft position
   -- the domain consumes it as the "value relative to market ADP" evidence line
   and never surfaces the number itself -- so the column rendered an em dash on
   every row of every board. The market signal is in the evidence panel. *@
@* A string, not the bool. Blazor treats a bool-valued attribute as a boolean
   attribute: false omits it entirely and true writes it with no value, so
   `[data-ranked="True"]` and `[data-ranked="False"]` both matched nothing and
   every column-width rule below was dead. *@
<div class="player-table"
     data-player-table
     data-ranked="@(Ranked ? "true" : "false")">
    <table>
        <caption>@Caption</caption>
        <thead>
            <tr>
                @if (Ranked)
                {
                    <th scope="col">Rank</th>
                }
                <th scope="col">Player</th>
                <th scope="col">Pos</th>
                @if (Ranked)
                {
                    <th scope="col" class="numeric">Value</th>
                    <th scope="col" class="numeric">VAR</th>
                    <th scope="col"><span class="visually-hidden">Recommendation</span></th>
                }
            </tr>
        </thead>
        <tbody>
            <Virtualize Items="@Rows"
                        Context="row"
                        ItemSize="28"
                        SpacerElement="tr">
                <PlayerRow Item="@row"
                           Ranked="@Ranked"
                           Rank="@RankOf(row)"
                           @key="row.Id" />
            </Virtualize>
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IList<PlayerTableItem> Rows { get; set; } = [];

    [Parameter]
    public string Caption { get; set; } = "Available fantasy basketball players";

    /// <summary>
    /// True where the row order is a ranking and projections exist. False on a
    /// plain search result, which shows neither a rank nor projection columns.
    /// </summary>
    [Parameter]
    public bool Ranked { get; set; } = true;

    // Rank was `Rows.IndexOf(row) + 1`, evaluated inside Virtualize for every
    // rendered row: a linear scan of the whole pool per row, so a five-hundred
    // player board did a quadratic amount of work to print its own line
    // numbers. Built once per parameter change instead.
    private Dictionary<PlayerId, int> ranks = [];

    protected override void OnParametersSet()
    {
        ranks = new Dictionary<PlayerId, int>(Rows.Count);
        for (var index = 0; index < Rows.Count; index++)
        {
            ranks.TryAdd(Rows[index].Id, index + 1);
        }
    }

    private int RankOf(PlayerTableItem row) =>
        ranks.TryGetValue(row.Id, out var rank) ? rank : 0;
}
