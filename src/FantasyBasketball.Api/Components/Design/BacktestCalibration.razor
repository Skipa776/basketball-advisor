<section class="calibration" aria-labelledby="@HeadingId">
    <div>
        <p class="eyebrow">Back-test</p>
        <h2 id="@HeadingId">@Title</h2>
    </div>
    <svg viewBox="0 0 100 100"
         role="img"
         aria-label="@AccessibleLabel"
         preserveAspectRatio="xMidYMid meet">
        <line class="reference" x1="5" y1="95" x2="95" y2="5" />
        @foreach (var point in Points)
        {
            <circle cx="@Coordinate(point.Predicted)"
                    cy="@Coordinate(1m - point.Actual)"
                    r="2">
                <title>Predicted @Percent(point.Predicted), actual @Percent(point.Actual)</title>
            </circle>
        }
    </svg>
    <p class="chart-note">Diagonal marks perfect calibration. Each point compares predicted and observed outcome rates.</p>
</section>

@code {
    private readonly string HeadingId = $"calibration-{Guid.NewGuid():N}";

    [Parameter]
    public string Title { get; set; } = "Projection calibration";

    [Parameter, EditorRequired]
    public IReadOnlyList<CalibrationPoint> Points { get; set; } = [];

    private string AccessibleLabel =>
        $"{Title}. {Points.Count} calibration observations against a perfect-calibration reference line.";

    private static string Coordinate(decimal value) =>
        (5m + (Math.Clamp(value, 0m, 1m) * 90m))
            .ToString("0.##", CultureInfo.InvariantCulture);

    private static string Percent(decimal value) =>
        Math.Clamp(value, 0m, 1m).ToString("P0", CultureInfo.InvariantCulture);
}
