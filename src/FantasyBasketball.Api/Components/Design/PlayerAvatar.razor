@* Three states, in order of preference: a real photo, the shipped placeholder,
   or initials drawn from the tokens.

   Initials are last but they are the only one that always works, needs no
   network, no licence, and no binary -- so the component is built so a missing
   photo is an ordinary state rather than a broken image. A design that assumes
   every player has a portrait fails on the first rookie. *@
<span class="avatar @SizeClass" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        @* Decorative: the player's name is always rendered beside this, so an
           alt here would have a screen reader say it twice. loading=lazy
           because a board renders fifty of these and none are above the fold. *@
        <img src="@ImageUrl" alt="" loading="lazy" decoding="async" />
    }
    else
    {
        <span class="initials">@Initials</span>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// A player portrait, or null. Null is the expected case, not the
    /// exception: no photo set covers every player in the league.
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>Larger on a profile, smaller in a dense row.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private string SizeClass => Compact ? "is-compact" : string.Empty;

    /// <summary>
    /// First letter of the first and last word. "Shai Gilgeous-Alexander"
    /// gives SG, a mononym gives one letter, and empty gives nothing rather
    /// than throwing -- this renders during a draft and must never be the
    /// reason a row fails.
    /// </summary>
    private string Initials
    {
        get
        {
            var parts = Name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries
                    | StringSplitOptions.TrimEntries);

            return parts.Length switch
            {
                0 => string.Empty,
                1 => parts[0][..1].ToUpperInvariant(),
                _ => string.Concat(
                    parts[0][..1],
                    parts[^1][..1]).ToUpperInvariant(),
            };
        }
    }
}
