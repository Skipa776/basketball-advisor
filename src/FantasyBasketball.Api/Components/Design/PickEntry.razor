<section class="pick-entry" aria-labelledby="@HeadingId">
    <div class="entry-heading">
        <div>
            <p class="eyebrow">Pick entry</p>
            <h2 id="@HeadingId">@Title</h2>
        </div>
        @if (CanUndo)
        {
            <button type="button" class="secondary" @onclick="UndoAsync">Undo last pick</button>
        }
    </div>
    <p class="instruction">Type to filter, use the arrow keys, then press Enter.</p>
    <label for="@InputId">Player</label>
    <div class="combobox">
        <input id="@InputId"
               @ref="Input"
               value="@Query"
               @oninput="UpdateQuery"
               @onkeydown="HandleKeyAsync"
               autocomplete="off"
               role="combobox"
               aria-autocomplete="list"
               aria-controls="@ListboxId"
               aria-expanded="@(FilteredItems.Count > 0)"
               aria-activedescendant="@ActiveOptionId" />
        <span class="shortcut" aria-hidden="true">↑ ↓ ↵</span>
    </div>
    <ul id="@ListboxId" role="listbox" aria-label="Matching players">
        @for (var index = 0; index < FilteredItems.Count; index++)
        {
            var item = FilteredItems[index];
            <li id="@OptionId(index)"
                role="option"
                aria-selected="@(index == SelectedIndex)"
                @onclick="() => CommitAsync(item)"
                @key="item.Id">
                <span>@item.Name</span>
                <span class="position">@item.Positions</span>
            </li>
        }
    </ul>
</section>

@code {
    private readonly string HeadingId = $"pick-entry-{Guid.NewGuid():N}";
    private readonly string InputId = $"pick-search-{Guid.NewGuid():N}";
    private readonly string ListboxId = $"pick-results-{Guid.NewGuid():N}";
    private ElementReference Input;
    private string Query = string.Empty;
    private int SelectedIndex;
    private bool restoreFocus;

    [Parameter]
    public string Title { get; set; } = "Record a pick";

    [Parameter, EditorRequired]
    public IReadOnlyList<PickEntryItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<PickEntryItem> OnCommit { get; set; }

    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    private IReadOnlyList<PickEntryItem> FilteredItems =>
        Items.Where(item =>
                string.IsNullOrWhiteSpace(Query)
                || item.Name.Contains(Query, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToArray();

    private string? ActiveOptionId => FilteredItems.Count == 0
        ? null
        : OptionId(Math.Clamp(SelectedIndex, 0, FilteredItems.Count - 1));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreFocus)
        {
            restoreFocus = false;
            await Input.FocusAsync();
        }
    }

    private void UpdateQuery(ChangeEventArgs args)
    {
        Query = args.Value?.ToString() ?? string.Empty;
        SelectedIndex = 0;
    }

    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        var count = FilteredItems.Count;
        if (args.Key == "ArrowDown" && count > 0)
        {
            SelectedIndex = Math.Min(SelectedIndex + 1, count - 1);
        }
        else if (args.Key == "ArrowUp" && count > 0)
        {
            SelectedIndex = Math.Max(SelectedIndex - 1, 0);
        }
        else if (args.Key == "Enter" && count > 0)
        {
            await CommitAsync(FilteredItems[
                Math.Clamp(SelectedIndex, 0, count - 1)]);
        }
    }

    private async Task CommitAsync(PickEntryItem item)
    {
        await OnCommit.InvokeAsync(item);
        Query = string.Empty;
        SelectedIndex = 0;
        restoreFocus = true;
    }

    private async Task UndoAsync()
    {
        await OnUndo.InvokeAsync();
        restoreFocus = true;
    }

    private string OptionId(int index) => $"{ListboxId}-{index}";
}
