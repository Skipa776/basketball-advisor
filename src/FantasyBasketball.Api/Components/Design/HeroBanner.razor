<section class="hero" aria-labelledby="hero-title">
    <CourtBackdrop />
    <div class="hero-body">
        <h1 id="hero-title">@Title</h1>
        <p class="slogan">@Slogan</p>
        <p class="accent-line">@AccentLine</p>
        <div class="hero-actions">
            <a class="cta" href="@ActionHref">@ActionLabel</a>
            @if (!string.IsNullOrWhiteSpace(SecondaryHref))
            {
                <a class="secondary" href="@SecondaryHref">@SecondaryLabel</a>
            }
        </div>
        @if (Platforms is not null)
        {
            <div class="hero-platforms">@Platforms</div>
        }
    </div>
    @* No target means the page below the fold is empty, and a hint that scrolls
       nowhere is a broken promise. *@
    @if (!string.IsNullOrWhiteSpace(ScrollTarget))
    {
        @* Drawn, not a unicode glyph borrowed from the body font. A text
           chevron inherits the font's own metrics and optical weight, so it
           never quite matches the stroke of anything around it. *@
        <a class="scroll-hint" href="@ScrollTarget">
            <span>Scroll to browse</span>
            <svg class="chevron"
                 viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">
                <path d="M5 9l7 7 7-7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
        </a>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Slogan { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AccentLine { get; set; } = string.Empty;
    [Parameter]
    public string ActionLabel { get; set; } = "Get started";

    [Parameter]
    public string ActionHref { get; set; } = "/account/register";

    [Parameter]
    public string? SecondaryLabel { get; set; }

    [Parameter]
    public string? SecondaryHref { get; set; }

    [Parameter]
    public string? ScrollTarget { get; set; } = "#movers";

    [Parameter]
    public RenderFragment? Platforms { get; set; }
}
