@* Nominative use only: these name the formats a league can arrive in. No logos,
   no partnership implied, and the disclaimer is part of the component so it
   cannot be dropped by a page that reuses this. *@
<div class="platform-row">
    <p class="label" id="platform-row-label">@Label</p>
    <ul aria-labelledby="platform-row-label">
        @foreach (var platform in Platforms)
        {
            <li>
                <span class="name">@platform.Name</span>
                <span class="support">@platform.Support</span>
            </li>
        }
    </ul>
    <p class="disclaimer">
        Not affiliated with, endorsed by, or sponsored by any of these services.
        Names are used only to describe the league formats this tool can read.
    </p>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ImportPlatformItem> Platforms { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Bring your league from";
}
