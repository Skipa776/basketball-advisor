@* role=group with aria-roledescription is the pattern for a carousel that is
   not a tab set. Slide content is never announced automatically: an auto-
   advancing live region interrupts a screen reader mid-sentence. *@
<section class="carousel"
         id="@Id"
         data-carousel
         data-carousel-interval="@IntervalMilliseconds"
         role="group"
         aria-roledescription="carousel"
         aria-labelledby="@($"{Id}-title")">
    <header class="carousel-head">
        <div>
            <h2 id="@($"{Id}-title")">@Title</h2>
        </div>
        <div class="carousel-controls">
            <ul class="dots" role="list">
                @for (var index = 0; index < Boards.Count; index++)
                {
                    var board = Boards[index];
                    <li>
                        <button type="button"
                                data-carousel-dot
                                aria-current="@(index == 0 ? "true" : "false")">
                            @board.ScoringLabel
                        </button>
                    </li>
                }
            </ul>
            @* Rendered hidden and revealed by the script: without JS nothing
               moves, so a pause button would control nothing. *@
            <button type="button"
                    class="toggle"
                    data-carousel-toggle
                    aria-pressed="false"
                    hidden>
                <span aria-hidden="true">⏸</span>
                <span data-carousel-toggle-label>Pause</span>
                <span class="visually-hidden"> automatic rotation</span>
            </button>
        </div>
    </header>

    @for (var index = 0; index < Boards.Count; index++)
    {
        var board = Boards[index];
        <div class="slide"
             data-carousel-slide
             role="group"
             aria-roledescription="slide"
             aria-label="@($"{board.Title}, {index + 1} of {Boards.Count}")"
             hidden="@(index != 0)">
            @* Four identical cards was the lazy container, and it also broke the
               contract's own rule: tables are the layout for player data, cards
               are for single-subject summaries. This is four players, so it is a
               list. Grouping by direction lets the eye answer "who is up, who is
               down" before reading a single name, and the move size leads each
               row because the size of the move is the story. *@
            @foreach (var group in GroupBoard(board))
            {
                <div class="mover-group">
                    <h3>@group.Label</h3>
                    <ul class="movers" role="list">
                        @foreach (var mover in group.Movers)
                        {
                            <li class="mover">
                                @* Direction is never colour alone: the arrow
                                   shape and the word both carry it, per D-12. *@
                                <span class="delta @DirectionClass(mover)">
                                    <svg class="arrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                                        <path d="@DirectionPath(mover)"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.75"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                    <span class="delta-value" data-numeric>@Math.Abs(mover.RankDelta)</span>
                                    <span class="delta-word">@DirectionWord(mover)</span>
                                </span>
                                <span class="mover-name">@mover.Name</span>
                                <span class="mover-meta">
                                    <span>@mover.Team</span>
                                    <span aria-hidden="true">·</span>
                                    <span>@mover.Positions</span>
                                </span>
                                @* Reason before rank so the flexible column is
                                   the prose and the rank anchors hard right.
                                   The other order left a dead gap mid-row. *@
                                <span class="mover-reason">@mover.Reason</span>
                                <span class="mover-rank">
                                    <span class="rank-label">now</span>
                                    <span class="rank" data-numeric>@mover.Rank</span>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MoverBoard> Boards { get; set; } = [];

    [Parameter]
    public string Id { get; set; } = "movers";

    [Parameter]
    public string Title { get; set; } = "Risers and fallers, last seven days";
    [Parameter]
    public int IntervalMilliseconds { get; set; } = 6000;

    private static string DirectionClass(MoverItem mover) =>
        mover.Direction == MoveDirection.Riser ? "is-riser" : "is-faller";

    /// <summary>
    /// Drawn rather than the ▲/▼ glyphs this used to borrow from the body font.
    /// A text arrow inherits that font's optical weight and never matches the
    /// stroke of the icons around it.
    /// </summary>
    private static string DirectionPath(MoverItem mover) =>
        mover.Direction == MoveDirection.Riser
            ? "M6 10V2M2.5 5.5L6 2l3.5 3.5"
            : "M6 2v8M2.5 6.5L6 10l3.5-3.5";

    private static string DirectionWord(MoverItem mover) =>
        mover.Direction == MoveDirection.Riser ? "up" : "down";

    /// <summary>
    /// Risers first, then fallers, each keeping the board's own order. Empty
    /// groups are dropped so a board of only risers does not render a
    /// "Falling" heading over nothing.
    /// </summary>
    private static IEnumerable<(string Label, IReadOnlyList<MoverItem> Movers)> GroupBoard(
        MoverBoard board) =>
        new[]
        {
            ("Rising", Filter(board, MoveDirection.Riser)),
            ("Falling", Filter(board, MoveDirection.Faller)),
        }.Where(group => group.Item2.Count > 0);

    private static IReadOnlyList<MoverItem> Filter(
        MoverBoard board,
        MoveDirection direction) =>
        [.. board.Movers.Where(mover => mover.Direction == direction)];
}
