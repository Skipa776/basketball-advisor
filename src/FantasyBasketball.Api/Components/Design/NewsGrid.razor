<section class="news" id="@Id" aria-labelledby="@($"{Id}-title")">
    <header>
        <h2 id="@($"{Id}-title")">@Title</h2>
    </header>
    <ul role="list">
        @foreach (var item in Items)
        {
            <li>
                <p class="outlet">
                    <span>@item.Outlet</span>
                    <span aria-hidden="true">·</span>
                    <span>@item.Age</span>
                </p>
                <h3>@item.Headline</h3>
                <p class="summary">@item.Summary</p>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CoverageItem> Items { get; set; } = [];

    [Parameter]
    public string Id { get; set; } = "coverage";

    [Parameter]
    public string Title { get; set; } = "Trades and coverage awaiting review";}
