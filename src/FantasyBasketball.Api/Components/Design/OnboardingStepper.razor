<nav class="stepper" aria-label="Setup progress">
    <ol role="list">
        @for (var index = 0; index < Steps.Count; index++)
        {
            var step = Steps[index];
            var state = index < CurrentIndex ? "done" : index == CurrentIndex ? "current" : "todo";
            <li class="step is-@state" aria-current="@(index == CurrentIndex ? "step" : null)">
                @* The state word is written out, not signalled by colour alone. *@
                <span class="marker" data-numeric>@(index + 1)</span>
                <span class="step-body">
                    <span class="step-title">@step.Title</span>
                    <span class="step-description">@step.Description</span>
                    <span class="visually-hidden">@StateLabel(state)</span>
                </span>
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OnboardingStepItem> Steps { get; set; } = [];

    [Parameter]
    public int CurrentIndex { get; set; }

    private static string StateLabel(string state) => state switch
    {
        "done" => "Completed",
        "current" => "Current step",
        _ => "Not started",
    };
}
