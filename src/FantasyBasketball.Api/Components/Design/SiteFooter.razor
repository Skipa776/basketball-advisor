<footer class="site-footer">
    <div class="footer-grid">
        <div>
            <p class="wordmark">Fastbreak</p>
            <p class="tagline">A league-aware decision engine you run yourself.</p>
        </div>
        @* Every link here needs an account, so the heading says so rather than
           letting a signed-out visitor discover it at the sign-in wall. *@
        <nav aria-label="Footer navigation">
            <h2>In the app</h2>
            <a href="/players">Players</a>
            <a href="/draft">Draft Assistant</a>
            <a href="/data-sources">Data Sources</a>
        </nav>
        <nav aria-label="Project links">
            <h2>Project</h2>
            <a href="https://github.com/Skipa776/basketball-advisor">Source</a>
            <a href="https://github.com/Skipa776/basketball-advisor/blob/main/LICENSE">Licence</a>
            <a href="https://github.com/Skipa776/basketball-advisor/issues">Issues</a>
        </nav>
        <div>
            <h2>Elsewhere</h2>
            <ul class="socials" role="list">
                <li><a href="https://github.com/Skipa776/basketball-advisor">GitHub</a></li>
                <li><a href="https://github.com/Skipa776/basketball-advisor/discussions">Discussions</a></li>
            </ul>
        </div>
    </div>

    @* This replaces a sponsors row. There are no sponsors, and the honest thing
       to put in a footer is where the numbers came from. *@
    <div class="notice">
        <h2>Data and sources</h2>
        <p>
            Player identity and schedule from balldontlie. Season statistics from
            Basketball-Reference. Average draft position from FantasyPros, CSV, or
            manual entry. Requests are rate limited well below every host's
            threshold and robots directives are respected.
        </p>
        <p>
            Not affiliated with the NBA, ESPN, Yahoo, Sleeper, or any data
            provider. Terms-of-use compliance for each source is the operator's
            responsibility.
        </p>
    </div>

    <p class="copyright">© @Year Fastbreak · MIT licensed</p>
</footer>

@code {
    [Parameter]
    public int Year { get; set; } = DateTime.UtcNow.Year;
}
