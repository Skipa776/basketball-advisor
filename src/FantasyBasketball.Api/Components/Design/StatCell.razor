<td class="stat-cell" data-label="@Label" data-numeric>
    @if (Value is { } value)
    {
        <span>@value.ToString(Format, CultureInfo.InvariantCulture)</span>
    }
    else
    {
        <span class="missing" aria-label="@($"{Label} unavailable")">—</span>
    }
    @if (!string.IsNullOrWhiteSpace(Unit))
    {
        <span class="unit">@Unit</span>
    }
</td>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public decimal? Value { get; set; }

    [Parameter]
    public string Format { get; set; } = "0.##";

    [Parameter]
    public string? Unit { get; set; }
}
