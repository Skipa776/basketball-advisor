@* Loading placeholders at the real row height, so the loaded state occupies
   the geometry the skeleton already claimed and nothing jumps when data lands.
   That is the same layout-stability concern as row D-14, one step earlier in
   the lifecycle.

   aria-busy plus a single label, not one live region per row: a screen reader
   should hear "loading your leagues" once, not eight times. *@
<div class="skeleton" role="status" aria-busy="true" aria-label="@Label">
    @for (var row = 0; row < Rows; row++)
    {
        <div class="skeleton-row" aria-hidden="true"></div>
    }
</div>

@code {
    [Parameter]
    public int Rows { get; set; } = 5;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;
}
