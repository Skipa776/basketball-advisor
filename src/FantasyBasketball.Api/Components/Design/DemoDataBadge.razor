@* Row A-26: demo data rendered anywhere must be labelled fictional. This is a
   component rather than a string in a page so the label cannot be styled away
   or forgotten by whatever renders the sample content next. *@
<p class="demo-badge" data-demo-label>
    <span class="tag">Sample</span>
    <span>@Message</span>
</p>

@code {
    [Parameter]
    public string Message { get; set; } =
        "Fictional players and headlines, shown so the layout is legible before you import anything real.";
}
