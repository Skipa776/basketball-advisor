<section class="projection-decomposition" aria-labelledby="@HeadingId">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Projection pipeline</p>
            <h2 id="@HeadingId">@Title</h2>
        </div>
        <ConfidenceChip Confidence="@Confidence" />
    </div>
    @if (HasUnverifiedContext)
    {
        <p class="unverified"><span aria-hidden="true">△</span> Unverified context affects this estimate</p>
    }
    <ol>
        @foreach (var stage in Stages)
        {
            <li>
                <span class="stage-label">@stage.Label</span>
                <strong data-numeric>@stage.Value.ToString("0.###", CultureInfo.InvariantCulture)</strong>
                <span class="detail">@stage.Detail</span>
            </li>
        }
    </ol>
</section>

@code {
    private readonly string HeadingId = $"projection-{Guid.NewGuid():N}";

    [Parameter]
    public string Title { get; set; } = "Projection decomposition";

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectionStageItem> Stages { get; set; } = [];

    [Parameter]
    public Confidence Confidence { get; set; } = Confidence.Moderate;

    [Parameter]
    public bool HasUnverifiedContext { get; set; }
}
