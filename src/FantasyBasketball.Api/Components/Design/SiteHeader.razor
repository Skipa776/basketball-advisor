<header class="site-header">
    <a class="wordmark" href="/">
        <span class="wordmark-mark" aria-hidden="true">FB</span>
        <span class="wordmark-text">Fastbreak</span>
    </a>
    @* These are anchors into the landing page's own sections, which only exist
       when sample content is on. A nav that scrolls nowhere is worse than no
       nav, so the layout decides. *@
    @if (ShowSectionLinks)
    {
        <nav class="site-nav" aria-label="Primary navigation">
            <a href="#movers">Risers</a>
            <a href="#rankings">Rankings</a>
            <a href="#coverage">Coverage</a>
        </nav>
    }
    <div class="site-actions">
        <ThemeToggle />
        <a class="log-in" href="/account/login">Sign in</a>
        <a class="cta" href="/account/register">Create account</a>
    </div>
</header>

@code {
    [Parameter]
    public bool ShowSectionLinks { get; set; }
}
