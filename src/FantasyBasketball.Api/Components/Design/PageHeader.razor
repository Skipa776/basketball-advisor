<header class="page-header">
    @* No eyebrow. A label stacked above a heading says in small grey caps what
       the heading is about to say in full, and the heading is what people read.
       Anything the eyebrow was scoping belongs in the title or the
       description. *@
    <div>
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
