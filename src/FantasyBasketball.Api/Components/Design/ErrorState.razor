<section class="error-state" role="alert" aria-labelledby="@HeadingId">
    <span class="state-mark" aria-hidden="true">!</span>
    <div>
        <h2 id="@HeadingId">@Title</h2>
        <p>@Message</p>
        @if (!string.IsNullOrWhiteSpace(Recovery))
        {
            <p class="recovery">@Recovery</p>
        }
        @if (Action is not null)
        {
            <div class="action">@Action</div>
        }
    </div>
</section>

@code {
    private readonly string HeadingId = $"error-{Guid.NewGuid():N}";

    [Parameter]
    public string Title { get; set; } = "This view could not be loaded";

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? Recovery { get; set; }

    [Parameter]
    public RenderFragment? Action { get; set; }
}
