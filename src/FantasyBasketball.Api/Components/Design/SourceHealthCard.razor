<article class="source-health" data-state="@State">
    <div>
        <p class="source">@Item.Source</p>
        <p class="detail">@Item.Detail</p>
    </div>
    <div class="status">
        <span class="state-icon" aria-hidden="true">@StateIcon</span>
        <strong>@StateLabel</strong>
        <span>@Item.Age</span>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public SourceHealthItem Item { get; set; } = null!;

    private string State => Item.IsStale
        ? "stale"
        : Item.IsDegraded
            ? "degraded"
            : "healthy";

    private string StateLabel => Item.IsStale
        ? "Stale"
        : Item.IsDegraded
            ? "Degraded"
            : "Healthy";

    private string StateIcon => Item.IsStale
        ? "△"
        : Item.IsDegraded
            ? "!"
            : "✓";
}
