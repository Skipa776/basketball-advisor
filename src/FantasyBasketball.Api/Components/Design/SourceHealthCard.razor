<article class="source-health" data-state="@State">
    <div>
        <p class="source">@Item.Source</p>
        <p class="detail">@Item.Detail</p>
    </div>
    <div class="status">
        @* Drawn, one stroke weight, sharing the geometry of every other icon
           in the system. These were the △ ! and ✓ glyphs, which inherit the
           body font's optical weight and sat at three different visual
           weights beside each other. *@
        <span class="state-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false">
                <path d="@StatePath"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
        </span>
        <strong>@StateLabel</strong>
        <span>@Item.Age</span>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public SourceHealthItem Item { get; set; } = null!;

    private string State => Item.IsStale
        ? "stale"
        : Item.IsDegraded
            ? "degraded"
            : "healthy";

    private string StateLabel => Item.IsStale
        ? "Stale"
        : Item.IsDegraded
            ? "Degraded"
            : "Healthy";

    /// <summary>
    /// Stale is a clock, degraded is an alert, healthy is a check. The shape
    /// carries the state on its own -- colour only reinforces it, because a
    /// health view read at a glance cannot depend on hue.
    /// </summary>
    private string StatePath => Item.IsStale
        ? "M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zM8 5v3.2l2.2 1.3"
        : Item.IsDegraded
            ? "M8 2 1.7 13.2h12.6L8 2zM8 6.4v3M8 11.2h.01"
            : "M2.5 8.4 6.2 12l7.3-8";
}
