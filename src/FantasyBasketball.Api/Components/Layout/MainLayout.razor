@inherits LayoutComponentBase
@inject IOptions<DemoContentOptions> Demo
@inject IServiceScopeFactory Scopes
@inject ActiveLeague ActiveLeague

<a class="skip-link" href="#main-content">Skip to content</a>
<AuthorizeView>
    <Authorized>
        @* Signed in: the instrument. Sidebar, dense workspace, no marketing
           chrome -- this is the surface with a clock on it. *@
        <div class="app-frame">
            <aside class="sidebar">
                <a class="wordmark" href="/" aria-label="Fastbreak dashboard">
                    <span class="wordmark-mark" aria-hidden="true">FB</span>
                    <span>Fastbreak</span>
                </a>
                @* Ten routes in one flat list is a directory, not navigation.
                   Grouped by what the user came to do -- decide something, look
                   after the league, tend the data -- so the section they want is
                   found by scanning three labels instead of ten links. One nav
                   with one label: the groups are headings inside it, not four
                   separate landmarks a screen reader has to walk past. *@
                @* Closed by default and forced open above the breakpoint in
                   CSS, so this is an ordinary sidebar on a desktop and a
                   collapsed menu on a phone -- with no script either way.
                   It shipped with `open` and the phone paid for it: eleven
                   links and the theme toggle filled the first screen, and the
                   page's own heading started below all of them. *@
                <details class="nav-disclosure">
                    <summary>Menu</summary>
                    <nav aria-label="Primary navigation">
                    <p class="nav-group" id="nav-decide">Decide</p>
                    <ul aria-labelledby="nav-decide">
                        <li><NavLink href="/draft">Draft Assistant</NavLink></li>
                        <li><NavLink href="/trade">Trade Analyzer</NavLink></li>
                        <li><NavLink href="/free-agents">Free Agents</NavLink></li>
                    </ul>

                    <p class="nav-group" id="nav-league">League</p>
                    <ul aria-labelledby="nav-league">
                        <li><NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink></li>
                        <li><NavLink href="/leagues">My Leagues</NavLink></li>
                        <li><NavLink href="/league">League Rules</NavLink></li>
                        <li><NavLink href="/leaderboard">Leaderboard</NavLink></li>
                        <li><NavLink href="/players">Players</NavLink></li>
                    </ul>

                    <p class="nav-group" id="nav-data">Data</p>
                    <ul aria-labelledby="nav-data">
                        <li><NavLink href="/context-review">Context Review</NavLink></li>
                        <li><NavLink href="/data-sources">Data Sources</NavLink></li>
                        @* /welcome had no inbound link anywhere in the app: the
                           route sweep rendered it, every test passed, and no
                           user could reach it. Row D-28. *@
                        <li><NavLink href="/welcome">Set Up</NavLink></li>
                    </ul>
                    </nav>
                </details>
                <div class="sidebar-footer">
                    <ThemeToggle />
                    <a href="/account/logout">Sign out</a>
                </div>
            </aside>
            <div class="workspace">
                @* The league every page opens on, switchable from anywhere.
                   Pages used to make the user paste a League ID they had to
                   copy out of the address bar. Row D-32. *@
                @if (leagueOptions.Count > 0)
                {
                    <div class="utility-bar">
                        @* Resolved, not read raw. A select always renders its
                           first option, so a null cookie showed a league here
                           while every page below reported having none. *@
                        <LeagueSelector Options="@leagueOptions"
                                        SelectedId="@ActiveLeague.Resolve(
                                            leagueOptions.Select(o => o.Id))" />
                    </div>
                }
                <main id="main-content" tabindex="-1">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Signed out: the public site. Nobody who has not arrived yet needs a
           sidebar full of pages they cannot open. *@
        <div class="public-frame">
            <SiteHeader ShowSectionLinks="@Demo.Value.Enabled" />
            <main id="main-content" tabindex="-1">
                @Body
            </main>
            <SiteFooter />
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<LeagueOption> leagueOptions = [];

    protected override async Task OnInitializedAsync()
    {
        // Its OWN scope, deliberately. Blazor initialises the layout and the
        // page concurrently, and the request-scoped DbContext is not
        // thread-safe: querying it here raced every page that also queries on
        // init, and EF threw "a second operation was started on this context
        // instance". That took out the draft board, league setup and context
        // review outright -- they returned the API error envelope instead of a
        // page, and only a signed-in walk of the app showed it.
        //
        // A scope per layout render costs one extra connection and removes the
        // race by construction, which is the right trade for a switcher that
        // renders on every single page.
        //
        // The layout also renders for signed-out visitors, where there is no
        // user to own a league. Failing quietly is right: a switcher that
        // cannot load is a missing convenience, never a broken page.
        try
        {
            using var scope = Scopes.CreateScope();
            var leagues = scope.ServiceProvider
                .GetRequiredService<LeagueService>();

            leagueOptions =
            [
                .. (await leagues.ListAsync(CancellationToken.None))
                    .Select(league => new LeagueOption(league.Id, league.Name)),
            ];
        }
        catch (Exception)
        {
            leagueOptions = [];
        }
    }
}
