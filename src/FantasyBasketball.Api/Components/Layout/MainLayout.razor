@inherits LayoutComponentBase
@inject IOptions<DemoContentOptions> Demo

<a class="skip-link" href="#main-content">Skip to content</a>
<AuthorizeView>
    <Authorized>
        @* Signed in: the instrument. Sidebar, dense workspace, no marketing
           chrome -- this is the surface with a clock on it. *@
        <div class="app-frame">
            <aside class="sidebar">
                <a class="wordmark" href="/" aria-label="Fastbreak dashboard">
                    <span class="wordmark-mark" aria-hidden="true">FB</span>
                    <span>Fastbreak</span>
                </a>
                <nav aria-label="Primary navigation">
                    <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink href="/league">My League</NavLink>
                    <NavLink href="/players">Players</NavLink>
                    <NavLink href="/draft">Draft Assistant</NavLink>
                    <NavLink href="/context-review">Context Review</NavLink>
                    <NavLink href="/data-sources">Data Sources</NavLink>
                </nav>
                <div class="sidebar-footer">
                    <ThemeToggle />
                    <a href="/account/logout">Sign out</a>
                </div>
            </aside>
            <div class="workspace">
                <main id="main-content" tabindex="-1">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Signed out: the public site. Nobody who has not arrived yet needs a
           sidebar full of pages they cannot open. *@
        <div class="public-frame">
            <SiteHeader ShowSectionLinks="@Demo.Value.Enabled" />
            <main id="main-content" tabindex="-1">
                @Body
            </main>
            <SiteFooter />
        </div>
    </NotAuthorized>
</AuthorizeView>
