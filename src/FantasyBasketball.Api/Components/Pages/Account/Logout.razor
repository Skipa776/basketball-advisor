@page "/account/logout"

<PageTitle>Log out</PageTitle>
<PageHeader Title="Log out"
            Eyebrow="Local account"
            Description="End this authenticated browser session." />

<EmptyState Title="End this session?"
            Description="Your imported data, leagues, and draft history remain stored locally.">
    <Action>
        <form method="post" action="/account/logout">
            <AntiforgeryToken />
            <button type="submit">Log out</button>
        </form>
    </Action>
</EmptyState>
