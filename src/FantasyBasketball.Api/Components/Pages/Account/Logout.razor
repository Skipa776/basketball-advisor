@page "/account/logout"

<PageTitle>Sign out</PageTitle>
<PageHeader Title="Sign out"
            />

<EmptyState Title="Sign out of this browser?"
            Description="Your leagues, drafts, and imported data stay on this instance and will be here when you sign back in.">
    <Action>
        <form method="post" action="/account/logout/submit">
            <AntiforgeryToken />
            <button type="submit">Sign out</button>
        </form>
    </Action>
</EmptyState>
