@page "/account/login"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Sign in</PageTitle>

<AuthPanel Title="Sign in"
           Description="Resume your private leagues, projections, and draft sessions.">
    <ChildContent>
        @if (Error == "invalid")
        {
            <ErrorState Id="login-error"
                        Message="Email or password is incorrect."
                        Recovery="Check both fields and try again." />
        }
        else if (Error == "locked")
        {
            <ErrorState Id="login-error"
                        Message="Too many failed attempts locked this account temporarily."
                        Recovery="Wait about fifteen minutes, then sign in again." />
        }

        <form method="post"
              action="/account/login/submit"
              aria-describedby="@(Error is null ? null : "login-error")">
            <AntiforgeryToken />
            <p>
                <label for="login-email">Email</label>
                <input id="login-email" name="email" type="email" autocomplete="username" required />
            </p>
            <p>
                <label for="login-password">Password</label>
                <input id="login-password" name="password" type="password" autocomplete="current-password" required />
            </p>
            <p class="checkbox-row">
                <label>
                    <input name="rememberMe" type="checkbox" value="true" />
                    Keep me signed in
                </label>
            </p>
            <button class="submit" type="submit">Sign in</button>
        </form>
    </ChildContent>

    @* Rendered only when an operator has configured a client ID. A provider
       button that cannot complete a sign-in is worse than no button. *@
    @* Google sign-in is NOT rendered, and the config flag is not enough to
       bring it back. GoogleSignInOptions binds, but AddGoogle() is never
       called and no /account/external/google endpoint is mapped -- so an
       operator who set a client ID got a button that 404s.

       This component's own comment already had the right rule: "a provider
       button that cannot complete a sign-in is worse than no button." The
       IsConfigured gate only checked that the operator supplied a key, not
       that the app can perform the sign-in. Restoring the button means
       registering the handler and mapping the callback first. Row D-29. *@

    <Secondary>
        <a href="/account/register">Create account</a>
    </Secondary>
</AuthPanel>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
