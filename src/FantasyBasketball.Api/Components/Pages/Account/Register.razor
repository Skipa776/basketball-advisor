@page "/account/register"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject FantasyBasketball.Infrastructure.Persistence.FantasyDbContext Database
@inject IOptions<FantasyBasketball.Infrastructure.Identity.AuthOptions> Auth

<PageTitle>Create account</PageTitle>

@if (!registrationOpen)
{
    <AuthPanel Title="Registration is closed"
               Description="This instance already has an owner and is not accepting new accounts.">
        <ChildContent>
            <p class="closed-note">
                A self-hosted instance is claimed by its first account. If that
                account is yours, sign in. If it is not, ask whoever runs this
                instance to open registration or create an account for you.
            </p>
            <a class="submit-link" href="/account/login">Sign in instead</a>
        </ChildContent>
    </AuthPanel>
}
else
{
    @* The claim sentence is only true for the first account. Once an owner
       exists and the operator has opened registration, repeating it tells a
       league-mate something false about what they are about to do. *@
    <AuthPanel Title="Create account"
               Description="@(isFirstAccount
                   ? "The first account claims this instance and closes registration."
                   : "Your leagues, drafts, and context events stay private to your account.")">
        <ChildContent>
            @if (Error == "invalid")
            {
                <ErrorState Id="register-error"
                            Message="The account could not be created."
                            Recovery="Use a password of at least 12 characters, and an email address that does not already have an account here." />
            }

            <form method="post"
                  action="/account/register/submit"
                  aria-describedby="@(Error is null ? null : "register-error")">
                <AntiforgeryToken />
                <p>
                    <label for="register-name">Display name</label>
                    <input id="register-name" name="displayName" autocomplete="name" required />
                </p>
                <p>
                    <label for="register-email">Email</label>
                    <input id="register-email" name="email" type="email" autocomplete="username" required />
                </p>
                <p>
                    <label for="register-password">Password</label>
                    <input id="register-password"
                           name="password"
                           type="password"
                           minlength="12"
                           autocomplete="new-password"
                           required />
                    <small>At least 12 characters.</small>
                </p>
                <button class="submit" type="submit">Create account</button>
            </form>
        </ChildContent>

        @* Google sign-in is NOT rendered, and the config flag is not enough to
           bring it back. GoogleSignInOptions binds, but AddGoogle() is never
           called and no /account/external/google endpoint is mapped -- so an
           operator who set a client ID got a button that 404s.

           This component's own comment already had the right rule: "a provider
           button that cannot complete a sign-in is worse than no button." The
           IsConfigured gate only checked that the operator supplied a key, not
           that the app can perform the sign-in. Restoring the button means
           registering the handler and mapping the callback first. Row D-29. *@

        <Secondary>
            <a href="/account/login">Sign in instead</a>
        </Secondary>
    </AuthPanel>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private bool registrationOpen;
    private bool isFirstAccount;

    protected override async Task OnInitializedAsync()
    {
        isFirstAccount = !await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
            .AnyAsync(Database.Users);
        registrationOpen = Auth.Value.OpenRegistration || isFirstAccount;
    }
}
