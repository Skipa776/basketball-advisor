@page "/league"
@rendermode InteractiveServer
@inject LeagueService Leagues

<PageTitle>My League</PageTitle>
<h1>My League</h1>

<form @onsubmit="CreateLeagueAsync" @onsubmit:preventDefault>
    <fieldset disabled="@saving">
        <legend>Create a league</legend>
        <p>
            <label for="league-name">League name</label>
            <input id="league-name" @bind="name" required />
        </p>
        <p>
            <label for="team-count">Team count</label>
            <input id="team-count" type="number" min="2" @bind="teamCount" />
        </p>
        <p>
            <label for="league-type">League type</label>
            <select id="league-type" @bind="leagueType">
                @foreach (var value in Enum.GetValues<LeagueType>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </p>
        <p>
            <label for="league-cadence">Lineup cadence</label>
            <select id="league-cadence" @bind="cadence">
                @foreach (var value in Enum.GetValues<LineupCadence>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </p>
        <p>
            <label for="scoring-rules">Points scoring rules (for example, PTS=1,REB=1.2)</label>
            <input id="scoring-rules" @bind="scoringText" />
        </p>
        <p>
            <label for="categories">Categories (for example, PTS,REB,AST)</label>
            <input id="categories" @bind="categoriesText" />
        </p>
        <p>
            <label for="roster-slots">Roster slots (for example, PG,SG,SF,PF,C,UTIL,BENCH,IR)</label>
            <input id="roster-slots" @bind="rosterText" required />
        </p>
        <button type="submit">Create league</button>
    </fieldset>
</form>

@if (error is not null)
{
    <p role="alert">@error</p>
}
@if (league is not null)
{
    <section>
        <h2>@league.Name</h2>
        <p>League ID: <code>@league.Id</code></p>
        <p>@league.TeamCount teams · @league.Type · @league.Cadence lineups</p>
        <h3>Scoring</h3>
        <ul>
            @foreach (var rule in league.ScoringRules)
            {
                <li>@rule.Stat: @rule.PointsPerUnit points per unit</li>
            }
            @foreach (var category in league.Categories)
            {
                <li>@category category</li>
            }
        </ul>
        <p>Roster: @string.Join(", ", league.RosterSlots.Select(slot => slot.Kind))</p>
    </section>
}

@code {
    private string name = "My League";
    private int teamCount = 10;
    private LeagueType leagueType = LeagueType.Points;
    private LineupCadence cadence = LineupCadence.Daily;
    private string scoringText = string.Empty;
    private string categoriesText = string.Empty;
    private string rosterText = string.Empty;
    private bool saving;
    private string? error;
    private FantasyLeague? league;

    private async Task CreateLeagueAsync()
    {
        saving = true;
        error = null;
        try
        {
            var rules = ParseScoringRules();
            var categories = ParseValues<StatKey>(categoriesText, "category");
            var rosterSlots = ParseValues<RosterSlotKind>(
                    rosterText,
                    "roster slot")
                .Select(kind => new RosterSlot(kind))
                .ToArray();
            league = await Leagues.CreateAsync(
                new FantasyLeague(
                    Guid.NewGuid(),
                    name,
                    leagueType,
                    teamCount,
                    rules,
                    categories,
                    rosterSlots,
                    cadence),
                CancellationToken.None);
        }
        catch (Exception)
        {
            error = "The league could not be created. Check each field.";
        }
        finally
        {
            saving = false;
        }
    }

    private IReadOnlyList<ScoringRule> ParseScoringRules()
    {
        if (string.IsNullOrWhiteSpace(scoringText))
        {
            return [];
        }

        return scoringText.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries
                | StringSplitOptions.TrimEntries)
            .Select(value =>
            {
                var pair = value.Split(
                    '=',
                    StringSplitOptions.TrimEntries);
                if (pair.Length != 2
                    || !Enum.TryParse<StatKey>(pair[0], true, out var stat)
                    || !decimal.TryParse(
                        pair[1],
                        NumberStyles.Number,
                        CultureInfo.InvariantCulture,
                        out var points))
                {
                    throw new ArgumentException(
                        $"Unknown scoring rule '{value}'.");
                }

                return new ScoringRule(stat, points);
            })
            .ToArray();
    }

    private static IReadOnlyList<T> ParseValues<T>(
        string input,
        string label)
        where T : struct, Enum
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return [];
        }

        return input.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries
                | StringSplitOptions.TrimEntries)
            .Select(value => Enum.TryParse<T>(value, true, out var parsed)
                ? parsed
                : throw new ArgumentException($"Unknown {label} '{value}'."))
            .ToArray();
    }
}
