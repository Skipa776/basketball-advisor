@page "/league"
@rendermode InteractiveServer
@inject LeagueService Leagues

<PageTitle>My League</PageTitle>
<PageHeader Title="My League"
            Eyebrow="Scoring context"
            Description="League rules determine every projection value and draft recommendation." />

@if (error is not null)
{
    <ErrorState Id="league-error"
                Message="@error"
                Recovery="Check category, scoring, and roster values against the examples below." />
}

<div class="instrument-grid">
    <form @onsubmit="CreateLeagueAsync" @onsubmit:preventDefault>
        <fieldset disabled="@saving"
                  aria-describedby="@(error is null ? null : "league-error")">
            <legend>Create a league</legend>
            <p>
                <label for="league-name">League name</label>
                <input id="league-name" @bind="name" required />
            </p>
            <p>
                <label for="team-count">Team count</label>
                <input id="team-count" type="number" min="2" @bind="teamCount" />
            </p>
            <p>
                <label for="league-type">League type</label>
                <select id="league-type" @bind="leagueType">
                    @foreach (var value in Enum.GetValues<LeagueType>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </p>
            <p>
                <label for="league-cadence">Lineup cadence</label>
                <select id="league-cadence" @bind="cadence">
                    @foreach (var value in Enum.GetValues<LineupCadence>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </p>
            <p>
                <label for="scoring-rules">Points scoring rules</label>
                <input id="scoring-rules"
                       @bind="scoringText"
                       aria-describedby="scoring-help" />
                <small id="scoring-help">Example: PTS=1,REB=1.2</small>
            </p>
            <p>
                <label for="categories">Categories</label>
                <input id="categories"
                       @bind="categoriesText"
                       aria-describedby="categories-help" />
                <small id="categories-help">Example: PTS,REB,AST</small>
            </p>
            <p>
                <label for="roster-slots">Roster slots</label>
                <input id="roster-slots"
                       @bind="rosterText"
                       required
                       aria-describedby="roster-help" />
                <small id="roster-help">Example: PG,SG,SF,PF,C,UTIL,BENCH,IR</small>
            </p>
            <button type="submit">Create league</button>
        </fieldset>
    </form>

    @if (leagues.Count == 0)
    {
        <EmptyState Title="No league configured"
                    Description="Every projection and draft recommendation is computed under a league's own rules, so this comes first." />
    }
    else
    {
        @foreach (var league in leagues)
        {
            <article class="panel" aria-labelledby="league-summary-@league.Id">
                <p class="eyebrow">Active configuration</p>
                <h2 id="league-summary-@league.Id">@league.Name</h2>
                <p>
                    <code>@league.Id</code>
                    <small>League ID. Paste it into Players to see projections computed under these rules.</small>
                </p>
                <p>@league.TeamCount teams · @league.Type · @league.Cadence lineups</p>
                <h3>Scoring</h3>
                <ul>
                    @foreach (var rule in league.ScoringRules)
                    {
                        <li>
                            <span>@rule.Stat</span>
                            <strong data-numeric>@rule.PointsPerUnit.ToString("0.###", CultureInfo.InvariantCulture)</strong>
                        </li>
                    }
                    @foreach (var category in league.Categories)
                    {
                        <li><span>@category</span><strong>category</strong></li>
                    }
                </ul>
                <p>Roster: @string.Join(", ", league.RosterSlots.Select(slot => slot.Kind))</p>
            </article>
        }
    }
</div>

@code {
    private string name = "My League";
    private int teamCount = 10;
    private LeagueType leagueType = LeagueType.Points;
    private LineupCadence cadence = LineupCadence.Daily;
    private string scoringText = string.Empty;
    private string categoriesText = string.Empty;
    private string rosterText = string.Empty;
    private bool saving;
    private string? error;
    private IReadOnlyList<FantasyLeague> leagues = [];

    // Without this the page only ever showed a league in the render that
    // created it: navigating away and back said "No league configured" while
    // the league sat in the database, and the draft page's "use the ID shown
    // on My League" pointed at an ID the user could no longer see.
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        leagues = await Leagues.ListAsync(CancellationToken.None);

    private async Task CreateLeagueAsync()
    {
        saving = true;
        error = null;
        try
        {
            var rules = ParseScoringRules();
            var categories = ParseValues<StatKey>(categoriesText, "category");
            var rosterSlots = ParseValues<RosterSlotKind>(
                    rosterText,
                    "roster slot")
                .Select(kind => new RosterSlot(kind))
                .ToArray();
            await Leagues.CreateAsync(
                new FantasyLeague(
                    Guid.NewGuid(),
                    name,
                    leagueType,
                    teamCount,
                    rules,
                    categories,
                    rosterSlots,
                    cadence),
                CancellationToken.None);
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            // Every ArgumentException reaching here is raised by the parsers
            // below or by FantasyLeague's own validation, and names the token
            // the user has to correct. A generic message hides the one fact
            // they need.
            error = exception.Message;
        }
        catch (Exception)
        {
            error = "The league could not be created.";
        }
        finally
        {
            saving = false;
        }
    }

    private IReadOnlyList<ScoringRule> ParseScoringRules()
    {
        if (string.IsNullOrWhiteSpace(scoringText))
        {
            return [];
        }

        return scoringText.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries
                | StringSplitOptions.TrimEntries)
            .Select(value =>
            {
                var pair = value.Split('=', StringSplitOptions.TrimEntries);
                if (pair.Length != 2
                    || !Enum.TryParse<StatKey>(pair[0], true, out var stat)
                    || !decimal.TryParse(
                        pair[1],
                        NumberStyles.Number,
                        CultureInfo.InvariantCulture,
                        out var points))
                {
                    throw new ArgumentException(
                        $"Unknown scoring rule '{value}'.");
                }

                return new ScoringRule(stat, points);
            })
            .ToArray();
    }

    private static IReadOnlyList<T> ParseValues<T>(
        string input,
        string label)
        where T : struct, Enum
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return [];
        }

        return input.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries
                | StringSplitOptions.TrimEntries)
            .Select(value => Enum.TryParse<T>(value, true, out var parsed)
                ? parsed
                : throw new ArgumentException($"Unknown {label} '{value}'."))
            .ToArray();
    }
}
