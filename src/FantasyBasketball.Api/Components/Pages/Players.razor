@page "/players"
@inject PlayerQueryService PlayersService
@inject ProjectionDecompositionService Projections
@inject LeagueService Leagues
@inject ActiveLeague ActiveLeague

<PageTitle>Players</PageTitle>
<PageHeader Title="Players"
            Description="Search the imported player pool and inspect every stage of a league-specific projection." />

@* One control, not a form of them. Position and team filters would need a
   vocabulary this app does not own -- positions arrive from the provider as
   free text, so a fixed PG/SG/SF/PF/C list would silently return nothing
   against a pool that says "G-F". Search is the filter that is true. *@
<form class="filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <SearchField Id="player-search"
                 Label="Search players"
                 @bind-Value="search"
                 Help="Matches on name across every imported player." />
    <p class="filter-context">
        @if (leagueName is null)
        {
            <span>
                No active league, so projections are unavailable. Choose one in
                the bar above.
            </span>
        }
        else
        {
            <span>
                Projections are computed under
                <strong>@leagueName</strong> rules.
            </span>
        }
    </p>
</form>

@if (error is not null)
{
    <ErrorState Message="@error"
                Recovery="Confirm the player and league exist and that a projection run has completed." />
}

@if (players is null)
{
    <SkeletonRows Rows="8" Label="Loading the player pool" />
}
else if (players.Items.Count == 0 && !string.IsNullOrWhiteSpace(search))
{
    @* A search that matched nothing and a pool that is empty are different
       problems with different fixes, so they are different screens. *@
    <EmptyState Title="No player matches that search"
                Description="@($"Nothing in the imported pool matches \"{search}\". Check the spelling, or clear the search to see everyone.")">
        <Action>
            <button type="button" @onclick="ClearSearchAsync">Clear search</button>
        </Action>
    </EmptyState>
}
else if (players.Items.Count == 0)
{
    <EmptyState Title="No players imported yet"
                Description="The player pool arrives by import. Nothing on this page, the draft board, or any projection works until it has run at least once.">
        <Action>
            <a class="button-link primary" href="/data-sources">Open Data Sources</a>
        </Action>
    </EmptyState>
}
else
{
    @* Ranked="false": this list is alphabetical and carries no projections, so
       a rank column would number players by their initials and three stat
       columns would be a wall of em dashes. *@
    <PlayerTable Rows="@PlayerRows"
                 Ranked="false"
                 Caption="Player search results" />
}

@if (projection is not null)
{
    <ProjectionDecomposition Stages="@ProjectionStages"
                             Confidence="@projection.Adjusted.Confidence"
                             HasUnverifiedContext="@projection.Adjusted.HasUnverifiedContext" />
    <details class="panel">
        <summary>Projection stat detail</summary>
        <div class="instrument-grid">
            <section aria-labelledby="baseline-stats-heading">
                <h2 id="baseline-stats-heading">Baseline per game</h2>
                <dl class="stat-list">
                    @foreach (var stat in projection.Baseline.ProjectedPerGame.Values)
                    {
                        <div>
                            <dt>@stat.Key</dt>
                            <dd data-numeric>@stat.Value.ToString("0.###", CultureInfo.InvariantCulture)</dd>
                        </div>
                    }
                </dl>
            </section>
            <section aria-labelledby="adjusted-stats-heading">
                <h2 id="adjusted-stats-heading">Adjusted per game</h2>
                <dl class="stat-list">
                    @foreach (var stat in projection.Adjusted.ProjectedPerGame.Values)
                    {
                        <div>
                            <dt>@stat.Key</dt>
                            <dd data-numeric>@stat.Value.ToString("0.###", CultureInfo.InvariantCulture)</dd>
                        </div>
                    }
                </dl>
            </section>
        </div>
    </details>
}

@code {
    [SupplyParameterFromQuery]
    public Guid? PlayerId { get; set; }

    [SupplyParameterFromQuery]
    public Guid? LeagueId { get; set; }

    private string? search;
    private string? leagueName;
    private PagedResult<Player>? players;
    private FantasyBasketball.Application.Projections.ProjectionDecomposition? projection;
    private string? error;

    private IList<PlayerTableItem> PlayerRows =>
        players?.Items.Select(player => new PlayerTableItem(
                player.Id,
                player.FullName,
                string.Join("/", player.Positions),
                null,
                null,
                null,
                false,
                false,
                [],
                ProjectionLink(player.Id)))
            .ToList() ?? [];

    private IReadOnlyList<ProjectionStageItem> ProjectionStages =>
        projection is null
            ? []
            :
            [
                new(
                    "Baseline projection",
                    projection.Baseline.ProjectedGamesPlayed,
                    "projected games"),
                new(
                    "Context adjustment",
                    projection.Adjusted.AppliedContextEventIds.Count,
                    "applied context events"),
                new(
                    "Final projection",
                    projection.Value.PerGame,
                    "fantasy points per game"),
            ];

    protected override async Task OnParametersSetAsync()
    {
        // The switcher in the shell decides which league this page opens on.
        // An explicit ?leagueId= still wins, because a shared link should show
        // the league it names rather than whichever one the reader last chose.
        await LoadLeagueNameAsync();
        await SearchAsync();
        projection = null;
        if (PlayerId is null || LeagueId is null)
        {
            return;
        }

        try
        {
            projection = await Projections.GetAsync(
                new PlayerId(PlayerId.Value),
                LeagueId.Value,
                CancellationToken.None);
        }
        catch (Exception)
        {
            error = "The requested projection decomposition is unavailable.";
        }
    }

    // The league is named, not asked for. This page used to demand the caller
    // paste a League ID into a text box -- an identifier the interface itself
    // never showed them anywhere they could copy it from.
    private async Task LoadLeagueNameAsync()
    {
        leagueName = null;
        try
        {
            var leagues = await Leagues.ListAsync(CancellationToken.None);
            LeagueId ??= ActiveLeague.Resolve(
                leagues.Select(league => league.Id));
            leagueName = leagues
                .FirstOrDefault(league => league.Id == LeagueId)?.Name;
        }
        catch (Exception)
        {
            error = "The active league could not be read.";
        }
    }

    private async Task ClearSearchAsync()
    {
        search = null;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        error = null;
        try
        {
            players = await PlayersService.ListAsync(
                search,
                null,
                null,
                1,
                50,
                CancellationToken.None);
        }
        catch (Exception)
        {
            error = "Players could not be loaded.";
        }
    }

    private string ProjectionLink(PlayerId id) =>
        LeagueId is null
            ? $"/players?playerId={id.Value}"
            : $"/players?playerId={id.Value}&leagueId={LeagueId}";
}
