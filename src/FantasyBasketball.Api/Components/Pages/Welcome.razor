@page "/welcome"
@rendermode InteractiveServer

<PageTitle>Set up</PageTitle>
<PageHeader Title="Set up your league"
            Eyebrow="First run"
            Description="Three steps to get the board ranking against your rules." />

<OnboardingStepper Steps="@DemoContent.SetupSteps" CurrentIndex="@stepIndex" />

@* This wizard does not persist anything. It narrows the choices so the
   settings on My League make sense, and then hands over to the page that
   actually writes them. Wiring it to LeagueService is the obvious next step. *@
<div class="notice preview-note">
    <p>
        This walkthrough previews the settings for each platform. Creating the
        league itself still happens on <a href="/league">My League</a> — carry
        the values below across.
    </p>
</div>

@if (stepIndex == 0)
{
    <section aria-labelledby="platform-heading">
        <h2 id="platform-heading">Where is your league?</h2>
        <div class="action-grid">
            @foreach (var option in platforms)
            {
                <button type="button"
                        class="@(platform == option ? "selected" : null)"
                        @onclick="() => ChoosePlatform(option)">
                    @option
                </button>
            }
        </div>
        <p class="hint">The platform decides which scoring shapes are offered next.</p>
    </section>
}
else if (stepIndex == 1)
{
    <section aria-labelledby="scoring-heading">
        <h2 id="scoring-heading">How does @platform score?</h2>
        <div class="action-grid">
            @foreach (var option in ScoringOptions)
            {
                <button type="button"
                        class="@(scoring == option ? "selected" : null)"
                        @onclick="() => ChooseScoring(option)">
                    @option
                </button>
            }
        </div>
        <p class="hint">@ScoringHint</p>
        <button type="button" @onclick="() => stepIndex = 0">Back</button>
    </section>
}
else
{
    <section aria-labelledby="summary-heading">
        <h2 id="summary-heading">Carry these across</h2>
        <article class="panel">
            <p class="eyebrow">Suggested settings</p>
            <ul>
                <li><span>Platform</span><strong>@platform</strong></li>
                <li><span>League type</span><strong>@LeagueTypeFor()</strong></li>
                <li><span>Scoring</span><strong>@scoring</strong></li>
                <li><span>Roster slots</span><strong>@RosterFor()</strong></li>
            </ul>
            @if (ScoringRuleFor() is { } rules)
            {
                <p>Points rules: <code>@rules</code></p>
            }
        </article>
        <div class="action-grid">
            <a class="button-link primary" href="/league">Open My League</a>
            <button type="button" @onclick="() => stepIndex = 1">Back</button>
        </div>
    </section>
}

@code {
    private static readonly string[] platforms = ["ESPN", "Yahoo", "Sleeper", "Manual"];

    private int stepIndex;
    private string platform = "ESPN";
    private string scoring = string.Empty;

    private string[] ScoringOptions => platform == "Sleeper"
        ? ["Points", "Categories", "Sleeper points variant"]
        : ["Points", "Categories"];

    private string ScoringHint => platform == "Sleeper"
        ? "Sleeper's points variants differ from the standard preset, so they are listed separately."
        : "Points leagues score each stat by a multiplier. Category leagues compare totals per stat.";

    private void ChoosePlatform(string value)
    {
        platform = value;
        scoring = string.Empty;
        stepIndex = 1;
    }

    private void ChooseScoring(string value)
    {
        scoring = value;
        stepIndex = 2;
    }

    private string LeagueTypeFor() =>
        scoring == "Categories" ? "Categories" : "Points";

    private string RosterFor() =>
        platform == "Sleeper"
            ? "PG,SG,SF,PF,C,UTIL,UTIL,BENCH,IR"
            : "PG,SG,SF,PF,C,UTIL,BENCH,IR";

    private string? ScoringRuleFor() => scoring switch
    {
        "Points" => "PTS=1,REB=1.2,AST=1.5,STL=3,BLK=3,TOV=-1",
        "Sleeper points variant" => "PTS=1,REB=1.2,AST=1.5,STL=3,BLK=3,TOV=-1,FG3M=0.5",
        _ => null,
    };
}
