@page "/draft"
@rendermode InteractiveServer
@inject DraftSessionService Drafts
@inject DraftBoardService Boards
@inject PlayerQueryService PlayersService
@inject LeagueService Leagues
@inject IJSRuntime JavaScript

<PageTitle>Draft Assistant</PageTitle>
<PageHeader Title="Draft Assistant"
            Eyebrow="Live decision surface"
            Description="Record picks without leaving the keyboard. Rankings update from league value, scarcity, roster fit, market position, and risk." />

@if (error is not null)
{
    <ErrorState Id="draft-error"
                Message="@error"
                Recovery="Your current draft session is unchanged. Correct the input or retry the action." />
}

@if (session is null && leagues.Count == 0)
{
    <EmptyState Title="No league to draft for"
                Description="A draft needs league rules to rank against. Create one on My League, then come back.">
        <Action>
            <a class="button-link" href="/league">Create a league</a>
        </Action>
    </EmptyState>
}
else if (session is null)
{
    <form @onsubmit="StartDraftAsync" @onsubmit:preventDefault>
        <fieldset aria-describedby="@(error is null ? null : "draft-error")">
            <legend>Start a draft</legend>
            <p>
                <label for="draft-league">League</label>
                <select id="draft-league"
                        @bind="leagueText"
                        required
                        aria-describedby="draft-league-help">
                    @foreach (var option in leagues)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </select>
                <small id="draft-league-help">Leagues you have created on My League.</small>
            </p>
            <p>
                <label for="draft-slot">Your draft position</label>
                <input id="draft-slot" type="number" min="1" @bind="userSlot" />
            </p>
            <p>
                <label for="draft-rounds">Rounds</label>
                <input id="draft-rounds" type="number" min="1" @bind="roundCount" />
            </p>
            <button type="submit">Start draft</button>
        </fieldset>
    </form>
    <EmptyState Title="No active draft"
                Description="Choose a league above and start a session to load the ranked board and begin entering picks." />
}
else
{
    <section aria-label="Draft status">
        <strong data-numeric>Pick @session.CurrentPick</strong>
        <span> · @TurnLabel</span>
    </section>

    <div class="draft-workspace">
        <PickEntry Items="@AvailablePlayers"
                   OnCommit="RecordSelectedAsync"
                   CanUndo="@(session.Picks.Count > 0)"
                   OnUndo="UndoAsync" />

        @if (board is null)
        {
            <EmptyState Title="Rankings are loading"
                        Description="The board will appear when league projections are available." />
        }
        else if (board.Rankings.Count == 0)
        {
            <EmptyState Title="No ranked players"
                        Description="Import players and projections, then return to this draft session." />
        }
        else
        {
            <DraftBoard Items="@BoardItems" Banner="@board.Banner" />
        }
    </div>
}

<div class="visually-hidden"
     aria-live="polite"
     aria-atomic="true"
     data-live-region="pick">@pickAnnouncement</div>
<div class="visually-hidden"
     aria-live="polite"
     aria-atomic="true"
     data-live-region="top-recommendation">@topRecommendationAnnouncement</div>

@code {
    private string leagueText = string.Empty;
    private int userSlot = 1;
    private int roundCount = 13;
    private IReadOnlyList<FantasyLeague> leagues = [];
    private DraftSession? session;
    private DraftBoardResult? board;
    private IReadOnlyList<Recommendation> recommendations = [];
    private IReadOnlyList<Player> players = [];
    private DraftBoardSnapshot? pendingSnapshot;
    private string? pickAnnouncement;
    private string? topRecommendationAnnouncement;
    private string? error;

    // "1 picks until your next turn" is the kind of thing this product cannot
    // afford to print, and zero is not a countdown at all -- it is your turn.
    private string TurnLabel => session?.PicksUntilNextTurn switch
    {
        null or 0 => "your turn to pick",
        1 => "1 pick until your next turn",
        var count => $"{count} picks until your next turn",
    };

    private IReadOnlyList<PickEntryItem> AvailablePlayers
    {
        get
        {
            var drafted = session?.Picks
                .Select(pick => pick.PlayerId)
                .ToHashSet() ?? [];
            return players
                .Where(player => !drafted.Contains(player.Id))
                .Select(player => new PickEntryItem(
                    player.Id,
                    player.FullName,
                    string.Join("/", player.Positions)))
                .ToArray();
        }
    }

    private IReadOnlyList<DraftBoardItem> BoardItems
    {
        get
        {
            if (board is null)
            {
                return [];
            }

            var topPlayerId = recommendations.FirstOrDefault()?.SubjectPlayerId
                ?? board.Rankings.FirstOrDefault()?.PlayerId;
            return board.Rankings.Select(value =>
            {
                var recommendation = recommendations.FirstOrDefault(candidate =>
                    candidate.SubjectPlayerId == value.PlayerId);
                return new DraftBoardItem(
                    new PlayerTableItem(
                        value.PlayerId,
                        PlayerName(value.PlayerId),
                        PlayerPositions(value.PlayerId),
                        value.ProjectedSeasonValue,
                        value.ValueAboveReplacement,
                        null,
                        value.PlayerId == topPlayerId,
                        false,
                        value.Evidence),
                    recommendation?.Confidence ?? Confidence.Moderate);
            }).ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        leagues = await Leagues.ListAsync(CancellationToken.None);
        leagueText = leagues.Count == 0
            ? string.Empty
            : leagues[0].Id.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingSnapshot is not null)
        {
            var snapshot = pendingSnapshot;
            pendingSnapshot = null;
            await JavaScript.InvokeVoidAsync(
                "draftBoard.restore",
                "live-draft-board",
                snapshot);
        }
    }

    private async Task StartDraftAsync()
    {
        error = null;
        if (!Guid.TryParse(leagueText, out var leagueId))
        {
            error = "Select a league to draft for.";
            return;
        }

        try
        {
            session = await Drafts.CreateAsync(
                leagueId,
                userSlot,
                roundCount,
                CancellationToken.None);
            players = (await PlayersService.ListAsync(
                    null,
                    null,
                    null,
                    1,
                    Paging.MaximumLimit,
                    CancellationToken.None))
                .Items;
            await RefreshBoardAsync();
        }
        catch (Exception)
        {
            error = "The draft could not be started.";
        }
    }

    private async Task RecordSelectedAsync(PickEntryItem selected)
    {
        if (session is null)
        {
            return;
        }

        error = null;
        try
        {
            pendingSnapshot = await CaptureBoardAsync();
            await Drafts.RecordPickAsync(
                session.Id,
                session.CurrentPick,
                selected.Id,
                CancellationToken.None);
            session = (await Drafts.GetAsync(
                session.Id,
                CancellationToken.None)).Session;
            pickAnnouncement = $"Pick recorded: {selected.Name}.";
            await RefreshBoardAsync();
        }
        catch (Exception)
        {
            pendingSnapshot = null;
            error = "The pick could not be recorded.";
        }
    }

    private async Task UndoAsync()
    {
        if (session is null || session.Picks.Count == 0)
        {
            return;
        }

        error = null;
        try
        {
            pendingSnapshot = await CaptureBoardAsync();
            var removed = await Drafts.UndoPickAsync(
                session.Id,
                session.Picks[^1].PickNumber,
                CancellationToken.None);
            session = (await Drafts.GetAsync(
                session.Id,
                CancellationToken.None)).Session;
            pickAnnouncement = $"Pick removed: {PlayerName(removed.PlayerId)}.";
            await RefreshBoardAsync();
        }
        catch (Exception)
        {
            pendingSnapshot = null;
            error = "The last pick could not be undone.";
        }
    }

    private async Task RefreshBoardAsync()
    {
        if (session is null)
        {
            return;
        }

        var previousTop = recommendations.FirstOrDefault()?.SubjectPlayerId;
        board = await Boards.GetBoardAsync(
            session.Id,
            CancellationToken.None);
        recommendations = await Boards.GetRecommendationsAsync(
            session.Id,
            CancellationToken.None);
        var currentTop = recommendations.FirstOrDefault()?.SubjectPlayerId;
        if (currentTop != previousTop && currentTop is not null)
        {
            topRecommendationAnnouncement =
                $"Top recommendation changed to {PlayerName(currentTop.Value)}.";
        }
    }

    private async Task<DraftBoardSnapshot?> CaptureBoardAsync()
    {
        if (board is null || board.Rankings.Count == 0)
        {
            return null;
        }

        return await JavaScript.InvokeAsync<DraftBoardSnapshot?>(
            "draftBoard.capture",
            "live-draft-board");
    }

    private string PlayerName(PlayerId playerId) =>
        players.FirstOrDefault(player => player.Id == playerId)?.FullName
        ?? playerId.Value.ToString();

    private string PlayerPositions(PlayerId playerId) =>
        players.FirstOrDefault(player => player.Id == playerId) is { } player
            ? string.Join("/", player.Positions)
            : "—";

    public sealed record DraftBoardSnapshot(
        decimal ScrollTop,
        IReadOnlyList<DraftBoardRowSnapshot> Rows);

    public sealed record DraftBoardRowSnapshot(
        string PlayerId,
        decimal Offset);
}
