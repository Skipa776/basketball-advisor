@page "/"
@attribute [AllowAnonymous]
@inject DataSourceHealthService HealthService
@inject ImportRunQueryService ImportRuns
@inject TimeProvider Clock
@inject IOptions<DemoContentOptions> Demo

<AuthorizeView>
    <NotAuthorized>
        <PageTitle>Fastbreak</PageTitle>

        @if (Demo.Value.Enabled)
        {
            <DemoDataBadge />
        }

        <HeroBanner Title="Draft with evidence"
                    Eyebrow="Self-hosted decision instrument"
                    Slogan="The league-aware fantasy basketball decision engine"
                    AccentLine="Every pick shows its reasons"
                    ActionLabel="Create account"
                    ActionHref="/account/register"
                    SecondaryLabel="Sign in"
                    SecondaryHref="/account/login"
                    ScrollTarget="@(Demo.Value.Enabled ? "#movers" : null)">
            <Platforms>
                <PlatformRow Platforms="@DemoContent.Platforms" />
            </Platforms>
        </HeroBanner>

        @if (Demo.Value.Enabled)
        {
            <div class="public-section">
                <RiserCarousel Boards="@DemoContent.Movers" />
            </div>
            <RankList Players="@DemoContent.Rankings" />
            <div class="public-section">
                <NewsGrid Items="@DemoContent.Coverage" />
            </div>
        }
        else
        {
            <div class="public-section">
                <EmptyState Title="Nothing has been imported here yet"
                            Description="This instance is running but has no players, leagues, or projections. Create an account to set one up, or sign in if you already have one.">
                    <Action>
                        <a class="button-link primary" href="/account/register">Create account</a>
                    </Action>
                </EmptyState>
            </div>
        }
    </NotAuthorized>

    <Authorized>
        <PageTitle>Dashboard</PageTitle>
        <PageHeader Title="Dashboard"
                    Eyebrow="System overview"
                    Description="How fresh this instance's data is, and what it has imported recently.">
            <Actions>
                <a class="button-link" href="/data-sources">Open Data Sources</a>
                <a class="button-link primary" href="/draft">Open Draft Assistant</a>
            </Actions>
        </PageHeader>

        @if (error is not null)
        {
            <ErrorState Message="@error"
                        Recovery="Reload the page. If it keeps failing, whoever runs this instance should check that the database is reachable." />
        }
        else if (health is null || runs is null)
        {
            <EmptyState Title="Loading system status"
                        Description="Checking when each source last imported successfully." />
        }
        else
        {
            <section aria-labelledby="freshness-heading">
                <h2 id="freshness-heading">Data freshness</h2>
                <div class="status-list">
                    @foreach (var source in health)
                    {
                        <SourceHealthCard Item="@ToHealthItem(source)" />
                    }
                </div>
            </section>

            <section aria-labelledby="imports-heading">
                <h2 id="imports-heading">Recent imports</h2>
                @if (runs.Items.Count == 0)
                {
                    <EmptyState Title="No imports yet"
                                Description="Import teams and players first. Schedule, season statistics, and ADP can follow in any order.">
                        <Action>
                            <a class="button-link" href="/data-sources">Open Data Sources</a>
                        </Action>
                    </EmptyState>
                }
                else
                {
                    <table>
                        <caption>Ten most recent data imports</caption>
                        <thead>
                            <tr>
                                <th scope="col">Source</th>
                                <th scope="col">Status</th>
                                <th scope="col">Rows</th>
                                <th scope="col">Started</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in runs.Items)
                            {
                                <tr>
                                    <th scope="row">@run.Source</th>
                                    <td>@run.Status</td>
                                    <td data-numeric>@run.RowsWritten</td>
                                    <td><time datetime="@run.StartedAt.ToString("O")">@Age(run.StartedAt)</time></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<DataSourceHealth>? health;
    private PagedResult<DataImportRun>? runs;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        // Both of these read owned tables, and HttpUserContext.CurrentUserId
        // throws rather than returning empty when there is no request user. The
        // landing page is the one page an anonymous visitor reaches, so the
        // query has to be skipped here rather than caught downstream.
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        try
        {
            health = await HealthService.GetAsync(CancellationToken.None);
            runs = await ImportRuns.ListAsync(1, 10, CancellationToken.None);
        }
        catch (Exception)
        {
            error = "Data status could not be loaded.";
        }
    }

    private SourceHealthItem ToHealthItem(DataSourceHealth source) =>
        new(
            source.Source,
            source.IsDegraded,
            source.IsStale,
            source.LastSuccess is { } success
                ? $"updated {Age(success)}"
                : "never updated",
            source.LastFailure is { } failure
                ? $"Last failure {Age(failure)}"
                : "No recorded import failure");

    private string Age(DateTimeOffset value)
    {
        var elapsed = Clock.GetUtcNow() - value;
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{Math.Floor(elapsed.TotalMinutes)}m ago",
            < 1440 => $"{Math.Floor(elapsed.TotalHours)}h ago",
            _ => $"{Math.Floor(elapsed.TotalDays)}d ago",
        };
    }
}
