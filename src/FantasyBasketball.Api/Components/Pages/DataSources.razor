@page "/data-sources"
@inject DataSourceHealthService HealthService
@inject IImportJobQueue Jobs
@inject TimeProvider Clock

<PageTitle>Data Sources</PageTitle>
<PageHeader Title="Data Sources"
            Eyebrow="Ingestion control"
            Description="Run imports and inspect source freshness. Inferred or scraped context never becomes ground truth without review." />

@if (error is not null)
{
    <ErrorState Message="@error"
                Recovery="The previous successful import remains available. Check source configuration before retrying." />
}

<section aria-labelledby="run-import-heading">
    <h2 id="run-import-heading">Run an import</h2>
    <div class="action-grid">
        <button type="button" @onclick="() => QueueAsync(ImportJobKind.Players)">Import teams and players</button>
        <button type="button" @onclick="() => QueueAsync(ImportJobKind.Adp)">Import ADP</button>
    </div>
    <div class="instrument-grid">
        <fieldset>
            <legend>Schedule window</legend>
            <p>
                <label for="schedule-from">From</label>
                <input id="schedule-from" type="date" @bind="scheduleFrom" />
            </p>
            <p>
                <label for="schedule-to">Through</label>
                <input id="schedule-to" type="date" @bind="scheduleTo" />
            </p>
            <button type="button" @onclick="() => QueueAsync(ImportJobKind.Schedule)">Import schedule</button>
        </fieldset>
        <fieldset>
            <legend>Season statistics</legend>
            <p>
                <label for="season-year">Season end year</label>
                <input id="season-year" type="number" min="1947" max="2199" @bind="seasonEndYear" />
            </p>
            <button type="button" @onclick="() => QueueAsync(ImportJobKind.SeasonStats)">Import season stats</button>
        </fieldset>
    </div>
    @if (queuedRun is not null)
    {
        <p class="notice">Queued @queuedRun.Source import <code>@queuedRun.Id</code>.</p>
    }
</section>

<section aria-labelledby="source-health-heading">
    <h2 id="source-health-heading">Source health</h2>
    @if (sources is null)
    {
        <EmptyState Title="Loading source health"
                    Description="Freshness checks are still running." />
    }
    else if (sources.All(source => source.LastSuccess is null))
    {
        <EmptyState Title="No successful imports"
                    Description="Start with teams and players. Each source will report its age and most recent failure here." />
        <div class="status-list">
            @foreach (var source in sources)
            {
                <SourceHealthCard Item="@ToHealthItem(source)" />
            }
        </div>
    }
    else
    {
        <div class="status-list">
            @foreach (var source in sources)
            {
                <SourceHealthCard Item="@ToHealthItem(source)" />
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<DataSourceHealth>? sources;
    private string? error;
    private DataImportRun? queuedRun;
    private DateOnly scheduleFrom;
    private DateOnly scheduleTo;
    private int seasonEndYear;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        scheduleFrom = today;
        scheduleTo = today.AddDays(14);
        seasonEndYear = today.Month >= 7 ? today.Year + 1 : today.Year;

        try
        {
            sources = await HealthService.GetAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            error = "Source health could not be loaded.";
        }
    }

    private SourceHealthItem ToHealthItem(DataSourceHealth source) =>
        new(
            source.Source,
            source.IsDegraded,
            source.IsStale,
            source.LastSuccess is { } success
                ? $"updated {Age(success)}"
                : "never updated",
            source.LastFailure is { } failure
                ? $"Last failure {Age(failure)}"
                : "No recorded import failure");

    private string Age(DateTimeOffset value)
    {
        var elapsed = Clock.GetUtcNow() - value;
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{Math.Floor(elapsed.TotalMinutes)}m ago",
            < 1440 => $"{Math.Floor(elapsed.TotalHours)}h ago",
            _ => $"{Math.Floor(elapsed.TotalDays)}d ago",
        };
    }

    private async Task QueueAsync(ImportJobKind kind)
    {
        error = null;
        try
        {
            queuedRun = await Jobs.EnqueueAsync(
                kind switch
                {
                    ImportJobKind.Schedule => new ImportJobRequest(
                        kind,
                        From: scheduleFrom,
                        To: scheduleTo),
                    ImportJobKind.SeasonStats => new ImportJobRequest(
                        kind,
                        SeasonEndYear: seasonEndYear),
                    _ => new ImportJobRequest(kind),
                },
                CancellationToken.None);
        }
        catch (Exception)
        {
            error = "The import could not be queued.";
        }
    }
}
