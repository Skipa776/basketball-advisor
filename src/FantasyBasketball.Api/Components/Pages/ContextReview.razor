@page "/context-review"
@rendermode InteractiveServer
@inject ContextEventService ContextEvents
@inject ContextEventQueryService ContextQueries
@inject TimeProvider Clock
@inject IUserContext UserContext

<PageTitle>Context Review</PageTitle>
<PageHeader Title="Context Review"
            Description="Proposed injuries, role changes, and availability signals remain unverified until a reviewer accepts or rejects them." />

@if (error is not null)
{
    <ErrorState Id="context-error"
                Message="@error"
                Recovery="No proposal is promoted automatically. Retry after checking the IDs and values." />
}

<div class="instrument-grid">
    <form class="setup-form"
          @onsubmit="CreateAsync"
          @onsubmit:preventDefault>
        <fieldset disabled="@busy"
                  aria-describedby="@(error is null ? null : "context-error")">
            <legend>Create a proposed context event</legend>
            <p>
                <label for="context-player">Affected player ID</label>
                <input id="context-player"
                       @bind="playerText"
                       required
                       aria-describedby="context-player-help" />
                <small id="context-player-help">Open the player from Players; the id is in the address bar.</small>
            </p>
            <p>
                <label for="context-summary">Summary</label>
                <input id="context-summary" @bind="summary" required />
            </p>
            <p>
                <label for="context-type">Type</label>
                <select id="context-type" @bind="eventType">
                    @foreach (var value in Enum.GetValues<ContextEventType>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </p>
            <p>
                <label for="context-direction">Direction</label>
                <select id="context-direction" @bind="direction">
                    @foreach (var value in Enum.GetValues<ContextDirection>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </p>
            <button type="submit" class="primary">Create proposal</button>
        </fieldset>
    </form>

    <form class="setup-form"
          @onsubmit="OverrideAsync"
          @onsubmit:preventDefault>
        <fieldset disabled="@busy"
                  aria-describedby="@(error is null ? null : "context-error")">
            <legend>Override an impact</legend>
            <p>
                <label for="override-event">Context event ID</label>
                <input id="override-event"
                       @bind="overrideEventText"
                       aria-describedby="override-event-help" />
                @* This form used to ask for an identifier that no screen in the
                   product printed, which made it usable only by whoever wrote
                   it. The review queue below now shows each event's ID. Row
                   D-32. *@
                <small id="override-event-help">Shown against each row in the review queue below.</small>
            </p>
            <p>
                <label for="override-player">Player ID</label>
                <input id="override-player"
                       @bind="overridePlayerText"
                       aria-describedby="override-player-help" />
                <small id="override-player-help">Open the player from Players; the id is in the address bar.</small>
            </p>
            <p>
                <label for="minutes-delta">Minutes delta</label>
                <input id="minutes-delta" type="number" step="0.1" @bind="minutesDelta" />
            </p>
            <p>
                <label for="confidence-delta">Projection confidence delta</label>
                <input id="confidence-delta"
                       type="number"
                       step="0.1"
                       min="-1"
                       max="1"
                       @bind="confidenceDelta"
                       aria-describedby="confidence-delta-help" />
                <small id="confidence-delta-help">Between -1 and 1. Negative lowers confidence in the projections this event touches.</small>
            </p>
            <button type="submit">Save impact override</button>
        </fieldset>
    </form>
</div>

<section aria-labelledby="events-heading">
    <h2 id="events-heading">Review queue</h2>
    @if (events is null)
    {
        <EmptyState Title="Loading context events"
                    Description="The verification queue is still loading." />
    }
    else if (events.Items.Count == 0)
    {
        <EmptyState Title="Nothing needs review"
                    Description="New proposed context events will appear here before they can affect trusted output." />
    }
    else
    {
        <table>
            <caption>Context events awaiting or recording human review</caption>
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    <th scope="col">State</th>
                    <th scope="col">Direction</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contextEvent in events.Items)
                {
                    <tr>
                        <th scope="row">
                            <strong>@contextEvent.Type</strong>
                            <span>@contextEvent.Summary</span>
                            <code>@contextEvent.Id</code>
                        </th>
                        <td>@contextEvent.Verification</td>
                        <td>@contextEvent.Direction</td>
                        <td>
                            @* Every row's buttons read "Verify" and "Reject" out
                               of context, so the accessible name carries the
                               subject the visible label gets from its row. *@
                            @if (contextEvent.Verification == VerificationState.Proposed)
                            {
                                <button type="button"
                                        disabled="@busy"
                                        aria-label="@($"Verify: {contextEvent.Summary}")"
                                        @onclick="() => ReviewAsync(contextEvent.Id, true)">Verify</button>
                                <button type="button"
                                        disabled="@busy"
                                        aria-label="@($"Reject: {contextEvent.Summary}")"
                                        @onclick="() => ReviewAsync(contextEvent.Id, false)">Reject</button>
                            }
                            else
                            {
                                <span>Reviewed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private PagedResult<ContextEvent>? events;
    private string playerText = string.Empty;
    private string summary = string.Empty;
    private ContextEventType eventType = ContextEventType.RotationChange;
    private ContextDirection direction = ContextDirection.Neutral;
    private string overrideEventText = string.Empty;
    private string overridePlayerText = string.Empty;
    private decimal minutesDelta;
    private decimal confidenceDelta;
    private string? error;

    // A verified context event is a human decision about ground truth. Two of
    // them from one double-click is the kind of duplicate this page exists to
    // prevent, so every write here waits for the one before it.
    private bool busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        events = await ContextQueries.ListAsync(
            1,
            50,
            CancellationToken.None);
    }

    private async Task CreateAsync()
    {
        if (busy)
        {
            return;
        }

        error = null;
        if (!Guid.TryParse(playerText, out var playerValue))
        {
            error = "Enter a valid affected player ID.";
            return;
        }

        busy = true;
        try
        {
            var playerId = new PlayerId(playerValue);
            var now = Clock.GetUtcNow();
            var contextEvent = ContextEvent.Create(
                Guid.NewGuid(),
                eventType,
                null,
                playerId,
                [playerId],
                now,
                now,
                direction,
                0.5m,
                Confidence.Moderate,
                null,
                DataSourceName.Manual,
                null,
                summary);
            await ContextEvents.CreateAsync(
                contextEvent,
                [PlayerContextImpact.CreateDefault(
                    Guid.NewGuid(),
                    contextEvent,
                    playerId)],
                CancellationToken.None);
            summary = string.Empty;
            await LoadAsync();
        }
        catch (Exception)
        {
            error = "The context proposal could not be created.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReviewAsync(Guid contextEventId, bool verify)
    {
        if (busy)
        {
            return;
        }

        error = null;
        busy = true;
        try
        {
            if (verify)
            {
                await ContextEvents.VerifyAsync(
                    contextEventId,
                    UserContext.CurrentUserId,
                    CancellationToken.None);
            }
            else
            {
                await ContextEvents.RejectAsync(
                    contextEventId,
                    UserContext.CurrentUserId,
                    CancellationToken.None);
            }

            await LoadAsync();
        }
        catch (Exception)
        {
            error = "The review action could not be saved.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OverrideAsync()
    {
        if (busy)
        {
            return;
        }

        error = null;
        if (!Guid.TryParse(overrideEventText, out var eventId)
            || !Guid.TryParse(overridePlayerText, out var playerId))
        {
            error = "Enter valid event and player IDs.";
            return;
        }

        busy = true;
        try
        {
            await ContextEvents.OverrideImpactAsync(
                eventId,
                new PlayerId(playerId),
                new ContextImpactOverride(
                    minutesDelta,
                    0m,
                    0m,
                    0m,
                    0m,
                    0m,
                    confidenceDelta),
                UserContext.CurrentUserId,
                CancellationToken.None);
        }
        catch (Exception)
        {
            error = "The impact override could not be saved.";
        }
        finally
        {
            busy = false;
        }
    }
}
