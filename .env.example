# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain a real value.
#
#   cp .env.example .env
#   scripts/dev.sh --demo
#
# scripts/gate.sh scans every tracked file for key-shaped strings, so a real
# key committed here fails the build rather than reaching a remote.

# Required. The app refuses to boot without it.
# Free key: https://www.balldontlie.io
# Any non-empty value boots; a real one is only needed to import players.
BallDontLie__ApiKey=

# Optional. Defaults are in compose.yaml and suit the local Postgres container.
# ConnectionStrings__Fantasy=Host=localhost;Port=5432;Database=fantasy_basketball;Username=fantasy;Password=fantasy_local

# Optional. Anthropic key for LLM-proposed context events (R17). The feature is
# disabled without it and the app is fully usable that way.
# Llm__ApiKey=

# Optional. Seconds between requests to any one external host. The floor is 10
# (six a minute, the scraping policy's ceiling) and this can only raise it.
# balldontlie's free tier allows five a minute, so 13 is what a full player
# import needs there without earning a 429.
# Http__MinimumRequestIntervalSeconds=13
